## 11. One-Shot Recon (Copy-Paste Friendly)
A condensed version that logs to `/tmp/recon_$USER.txt`:

```bash
OUT="/tmp/recon_$(id -un)_$(date +%s).txt"
exec > >(tee -a "$OUT") 2>&1

echo "### ID";        id
echo "### SUDO";      sudo -l 2>/dev/null
echo "### KERNEL";    uname -a; cat /etc/redhat-release 2>/dev/null
echo "### SUID";      find / -xdev -type f -perm -4000 -ls 2>/dev/null
echo "### SGID";      find / -xdev -type f -perm -2000 -ls 2>/dev/null
echo "### WW-DIRS";   find / -xdev -type d -perm -o+w -ls 2>/dev/null
echo "### MY-WRITABLE"; find / -xdev -user "$(id -u)" -writable -ls 2>/dev/null
echo "### KEYS";      find /home /opt /etc /srv /var/www -type f \
  \( -name "id_*" -o -name "*.pem" -o -name "*.key" -o -name "authorized_keys" \) -readable -ls 2>/dev/null
echo "### CREDS-GREP"; grep -rilE "pass(word|wd)?=|secret=|token=|api_key=" \
  /var/www /opt /srv /etc /home 2>/dev/null
echo "### LISTEN";    ss -lntu
echo "### PROCESSES"; ps aux
echo "### SENSITIVE"; for f in /etc/shadow /etc/sudoers /root/.ssh/id_rsa; do
  [ -r "$f" ] && echo "[+] READABLE: $f"; done
echo "### DONE -> $OUT"
```

