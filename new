## 10. Web Server Config Files (Readable Only)
```bash
# Common web roots and their configs
ls -la /var/www/ /var/www/html/ /usr/share/nginx/html/ /srv/www/ 2>/dev/null

# Apache / Nginx main configs
for f in /etc/httpd/conf/httpd.conf /etc/httpd/conf.d/*.conf \
         /etc/nginx/nginx.conf /etc/nginx/conf.d/*.conf \
         /etc/nginx/sites-enabled/*; do
  [ -r "$f" ] && echo "[+] READABLE: $f" && grep -iE "pass|auth|key|proxy_pass" "$f" 2>/dev/null
done

# Readable .htpasswd / .htaccess
find /var/www /srv /opt -name ".htpasswd" -o -name ".htaccess" -readable 2>/dev/null

# App-specific credential locations
find /var/www /opt /srv -type f -readable \
  \( -name "*.env" -o -name "wp-config.php" -o -name "config.php" \
     -o -name "settings.py" -o -name "*.sqlite*" -o -name "*.db" \) 2>/dev/null
```

